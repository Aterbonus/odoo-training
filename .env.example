# Copia este archivo a .env y ajusta lo que necesites.
# .env NO debe subirse al repositorio (ver .gitignore).

# Versión de la imagen oficial de Odoo usada como base (dependencias del
# sistema, wkhtmltopdf, entrypoint). El código de Odoo NO viene de la imagen:
# se toma del source montado desde ./odoo (ver docker-compose.yml).
ODOO_BASE_VERSION=19.0

# Puerto local donde quedará expuesto Odoo (http://localhost:PUERTO)
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# Nombre de la base de datos por defecto (útil para los targets del Makefile)
ODOO_DB=odoo_dev

# Credenciales de PostgreSQL (solo para uso local/desarrollo)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres

# Contraseña del "master password" de Odoo (pantalla de gestión de BDs)
ODOO_ADMIN_PASSWD=admin
